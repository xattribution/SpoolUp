{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.xattribution.spoolup",
  "Name": "SpoolUp",
  "Version": "2.0.0.0",
  "Author": "xattribution",
  "Description": "Star Citizen controls through SpoolUp: live key lights, press animations, dials and scenes, with SpoolUp's focus check. Fan project, not affiliated with Cloud Imperium Games.",
  "URL": "https://github.com/xattribution/SpoolUp",
  "Icon": "imgs/plugin/icon",
  "Category": "SpoolUp",
  "CategoryIcon": "imgs/plugin/category",
  "CodePath": "bin/plugin.js",
  "PropertyInspectorPath": "pi/index.html",
  "SDKVersion": 3,
  "Software": { "MinimumVersion": "7.3" },
  "OS": [{ "Platform": "windows", "MinimumVersion": "10" }],
  "Nodejs": { "Version": "24" },
  "Actions": [
    {
      "UUID": "com.xattribution.spoolup.key",
      "Name": "Deck Button",
      "Tooltip": "Presses a SpoolUp button through its focus check, with live lights.",
      "Icon": "imgs/actions/key/icon",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "OS": ["windows"],
      "States": [{ "Image": "imgs/actions/key/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.xattribution.spoolup.dial",
      "Name": "Deck Dial",
      "Tooltip": "One SpoolUp press per detent; push or touch for a third button.",
      "Icon": "imgs/actions/dial/icon",
      "Controllers": ["Encoder"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "OS": ["windows"],
      "States": [{ "Image": "imgs/actions/dial/key", "ShowTitle": false }],
      "Encoder": {
        "layout": "layouts/dial.json",
        "Icon": "imgs/actions/dial/dial",
        "StackColor": "#12253b",
        "TriggerDescription": { "Rotate": "One press per detent", "Push": "Press", "Touch": "Press" }
      }
    },
    {
      "UUID": "com.xattribution.spoolup.scene",
      "Name": "Scene",
      "Tooltip": "Goes to a scene page of the SpoolUp profile; tablets can follow.",
      "Icon": "imgs/actions/scene/icon",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "OS": ["windows"],
      "States": [{ "Image": "imgs/actions/scene/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.xattribution.spoolup.theme",
      "Name": "Theme",
      "Tooltip": "Draws every SpoolUp key and dial in a manufacturer theme.",
      "Icon": "imgs/actions/theme/icon",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "OS": ["windows"],
      "States": [{ "Image": "imgs/actions/theme/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.xattribution.spoolup.talk",
      "Name": "Hold to Talk",
      "Tooltip": "Hold to speak a SpoolUp voice command.",
      "Icon": "imgs/actions/talk/icon",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "OS": ["windows"],
      "States": [{ "Image": "imgs/actions/talk/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.xattribution.spoolup.status",
      "Name": "Status",
      "Tooltip": "Shows the link to SpoolUp and its round trip.",
      "Icon": "imgs/actions/status/icon",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "OS": ["windows"],
      "States": [{ "Image": "imgs/actions/status/key", "ShowTitle": false }]
    },
    {
      "UUID": "com.xattribution.spoolup.lights",
      "Name": "Reset Lights",
      "Tooltip": "Turns off every lit key. SpoolUp can't see the game, so lights only show what was pressed.",
      "Icon": "imgs/actions/lights/icon",
      "Controllers": ["Keypad"],
      "UserTitleEnabled": false,
      "SupportedInMultiActions": false,
      "SupportedInKeyLogicActions": false,
      "OS": ["windows"],
      "States": [{ "Image": "imgs/actions/lights/key", "ShowTitle": false }]
    }
  ]
}
