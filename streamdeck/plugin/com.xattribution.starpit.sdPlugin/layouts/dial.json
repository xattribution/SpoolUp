{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/layout.json",
  "id": "tabletdeck-dial",
  "items": [
    { "key": "bg", "type": "pixmap", "rect": [0, 0, 200, 100], "zOrder": 0 },
    { "key": "icon", "type": "pixmap", "rect": [14, 28, 48, 48], "zOrder": 1 },
    { "key": "label", "type": "text", "rect": [72, 10, 118, 22], "zOrder": 1, "font": { "size": 15, "weight": 600 }, "alignment": "left", "text-overflow": "ellipsis", "color": "#e8eef5" },
    { "key": "value", "type": "text", "rect": [72, 36, 118, 30], "zOrder": 1, "font": { "size": 22, "weight": 700 }, "alignment": "left", "text-overflow": "ellipsis", "color": "#8aa0b8" },
    { "key": "hint", "type": "text", "rect": [72, 70, 118, 20], "zOrder": 1, "font": { "size": 11, "weight": 600 }, "alignment": "left", "text-overflow": "ellipsis", "color": "#8aa0b8" }
  ]
}
