<?xml version="1.0" encoding="utf-8"?>
<!-- The deck is served over plain http by a PC on the home network. Android can't scope
     cleartext to private IP ranges (domain-config matches host names, not subnets), so it's
     allowed here; the app itself only opens home network addresses (Pc.isLocal). -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
