/* SpoolUp app text. Keys are the English text in the Swift sources. */

"About SpoolUp" = "À propos de SpoolUp";
"Cancel" = "Annuler";
"Connect" = "Connecter";
"Couldn't open the deck: %@" = "Impossible d'ouvrir le deck : %@";
"Demo" = "Démo";
"Done" = "OK";
"Finding its address…" = "Recherche de son adresse…";
"Forget" = "Oublier";
"Looking for PCs didn't work. Scan the QR code or type the address instead." = "La recherche de PC n'a pas marché. Scannez le code QR ou tapez l'adresse.";
"Looking for SpoolUp on your PC…" = "Recherche de SpoolUp sur votre PC…";
"Name (optional)" = "Nom (facultatif)";
"Needs the free SpoolUp app for Windows on your PC. The demo works without it." = "Nécessite l'app gratuite SpoolUp pour Windows sur votre PC. La démo fonctionne sans elle.";
"On this network" = "Sur ce réseau";
"Open Settings" = "Ouvrir Réglages";
"Point the camera at the QR code in the SpoolUp window on your PC." = "Pointez la caméra vers le code QR de la fenêtre SpoolUp sur votre PC.";
"Privacy" = "Confidentialité";
"Saved PCs" = "PC enregistrés";
"Scan again" = "Scanner à nouveau";
"Scan the QR code" = "Scanner le code QR";
"Scan the QR code on your PC" = "Scanner le code QR de votre PC";
"SpoolUp can't look for PCs: Local Network is off for it." = "SpoolUp ne peut pas chercher de PC : le réseau local est désactivé pour lui.";
"SpoolUp collects nothing. The PCs you save stay on this device. The deck talks only to your PC, and loads its fonts from Google Fonts." = "SpoolUp ne collecte rien. Les PC enregistrés restent sur cet appareil. Le deck ne parle qu'à votre PC et charge ses polices depuis Google Fonts.";
"SpoolUp is an unofficial fan project. It isn't made by, affiliated with or endorsed by the maker of any game." = "SpoolUp est un projet de fan non officiel. Il n'est ni créé, ni affilié, ni approuvé par l'éditeur d'un jeu.";
"SpoolUp needs the camera to scan the QR code. You can turn it on in Settings, or type the address instead." = "SpoolUp a besoin de la caméra pour scanner le code QR. Activez-la dans Réglages ou tapez l'adresse.";
"SpoolUp only connects to PCs on your home network, like 192.168.1.20." = "SpoolUp ne se connecte qu'aux PC de votre réseau local, comme 192.168.1.20.";
"SpoolUp turns this iPad or iPhone into a control deck for your gaming PC. Each tap sends one key press to the SpoolUp app on the PC, over your home network." = "SpoolUp transforme cet iPad ou iPhone en deck de commande pour votre PC de jeu. Chaque appui envoie une frappe à l'app SpoolUp du PC, via votre réseau local.";
"Start SpoolUp on your gaming PC. It shows up here when the iPad or iPhone is on the same Wi-Fi." = "Lancez SpoolUp sur votre PC de jeu. Il apparaît ici quand l'iPad ou l'iPhone est sur le même Wi-Fi.";
"That QR code isn't a SpoolUp address. Use the one in the SpoolUp window on your PC." = "Ce code QR n'est pas une adresse SpoolUp. Utilisez celui de la fenêtre SpoolUp sur votre PC.";
"That isn't a SpoolUp address. It starts with http://" = "Ce n'est pas une adresse SpoolUp. Elle commence par http://";
"The PC didn't answer. Is SpoolUp running on it, on the same network?" = "Le PC n'a pas répondu. SpoolUp y tourne-t-il, sur le même réseau ?";
"The SpoolUp window on your PC shows its address. The deck asks for the pairing code next." = "La fenêtre SpoolUp sur votre PC affiche son adresse. Le deck demande ensuite le code d'appairage.";
"The demo runs without a PC. Presses only light up the buttons." = "La démo fonctionne sans PC. Les appuis allument seulement les boutons.";
"The port must be a number from 1024 to 65535." = "Le port doit être un nombre de 1024 à 65535.";
"Try the demo" = "Essayer la démo";
"Type the address" = "Taper l'adresse";
"Type the address the SpoolUp window shows on your PC." = "Tapez l'adresse affichée par la fenêtre SpoolUp sur votre PC.";
"Use the PC's IPv4 address, like 192.168.1.20." = "Utilisez l'adresse IPv4 du PC, comme 192.168.1.20.";
