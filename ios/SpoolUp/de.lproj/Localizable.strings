/* SpoolUp app text. Keys are the English text in the Swift sources. */

"About SpoolUp" = "Über SpoolUp";
"Cancel" = "Abbrechen";
"Connect" = "Verbinden";
"Couldn't open the deck: %@" = "Das Deck ließ sich nicht öffnen: %@";
"Demo" = "Demo";
"Done" = "Fertig";
"Finding its address…" = "Adresse wird gesucht…";
"Forget" = "Vergessen";
"Looking for PCs didn't work. Scan the QR code or type the address instead." = "Die PC-Suche hat nicht geklappt. Scanne den QR-Code oder tippe die Adresse ein.";
"Looking for SpoolUp on your PC…" = "Suche SpoolUp auf deinem PC…";
"Name (optional)" = "Name (optional)";
"Needs the free SpoolUp app for Windows on your PC. The demo works without it." = "Braucht die kostenlose SpoolUp-App für Windows auf deinem PC. Die Demo läuft auch ohne.";
"On this network" = "In diesem Netzwerk";
"Open Settings" = "Einstellungen öffnen";
"Point the camera at the QR code in the SpoolUp window on your PC." = "Richte die Kamera auf den QR-Code im SpoolUp-Fenster auf deinem PC.";
"Privacy" = "Datenschutz";
"Saved PCs" = "Gespeicherte PCs";
"Scan again" = "Erneut scannen";
"Scan the QR code" = "QR-Code scannen";
"Scan the QR code on your PC" = "QR-Code auf deinem PC scannen";
"SpoolUp can't look for PCs: Local Network is off for it." = "SpoolUp kann keine PCs suchen: Lokales Netzwerk ist dafür aus.";
"SpoolUp collects nothing. The PCs you save stay on this device. The deck talks only to your PC, and loads its fonts from Google Fonts." = "SpoolUp sammelt nichts. Gespeicherte PCs bleiben auf diesem Gerät. Das Deck spricht nur mit deinem PC und lädt seine Schriften von Google Fonts.";
"SpoolUp is an unofficial fan project. It isn't made by, affiliated with or endorsed by the maker of any game." = "SpoolUp ist ein inoffizielles Fanprojekt. Es stammt nicht vom Hersteller eines Spiels und ist mit keinem verbunden oder von ihm unterstützt.";
"SpoolUp needs the camera to scan the QR code. You can turn it on in Settings, or type the address instead." = "SpoolUp braucht die Kamera für den QR-Code. Du kannst sie in den Einstellungen erlauben oder die Adresse eintippen.";
"SpoolUp only connects to PCs on your home network, like 192.168.1.20." = "SpoolUp verbindet sich nur mit PCs in deinem Heimnetz, z. B. 192.168.1.20.";
"SpoolUp turns this iPad or iPhone into a control deck for your gaming PC. Each tap sends one key press to the SpoolUp app on the PC, over your home network." = "SpoolUp macht dieses iPad oder iPhone zum Steuerdeck für deinen Gaming-PC. Jedes Tippen schickt über dein Heimnetz einen Tastendruck an die SpoolUp-App auf dem PC.";
"Start SpoolUp on your gaming PC. It shows up here when the iPad or iPhone is on the same Wi-Fi." = "Starte SpoolUp auf deinem Gaming-PC. Er erscheint hier, wenn iPad oder iPhone im selben WLAN sind.";
"That QR code isn't a SpoolUp address. Use the one in the SpoolUp window on your PC." = "Dieser QR-Code ist keine SpoolUp-Adresse. Nimm den aus dem SpoolUp-Fenster auf deinem PC.";
"That isn't a SpoolUp address. It starts with http://" = "Das ist keine SpoolUp-Adresse. Sie beginnt mit http://";
"The PC didn't answer. Is SpoolUp running on it, on the same network?" = "Der PC hat nicht geantwortet. Läuft SpoolUp darauf, im selben Netzwerk?";
"The SpoolUp window on your PC shows its address. The deck asks for the pairing code next." = "Das SpoolUp-Fenster auf deinem PC zeigt seine Adresse. Danach fragt das Deck nach dem Kopplungscode.";
"The demo runs without a PC. Presses only light up the buttons." = "Die Demo läuft ohne PC. Tippen lässt nur die Tasten aufleuchten.";
"The port must be a number from 1024 to 65535." = "Der Port muss eine Zahl von 1024 bis 65535 sein.";
"Try the demo" = "Demo ausprobieren";
"Type the address" = "Adresse eintippen";
"Type the address the SpoolUp window shows on your PC." = "Tippe die Adresse ein, die das SpoolUp-Fenster auf deinem PC zeigt.";
"Use the PC's IPv4 address, like 192.168.1.20." = "Nimm die IPv4-Adresse des PCs, z. B. 192.168.1.20.";
