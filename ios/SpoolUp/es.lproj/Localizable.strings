/* SpoolUp app text. Keys are the English text in the Swift sources. */

"About SpoolUp" = "Acerca de SpoolUp";
"Cancel" = "Cancelar";
"Connect" = "Conectar";
"Couldn't open the deck: %@" = "No se pudo abrir el panel: %@";
"Demo" = "Demo";
"Done" = "Listo";
"Finding its address…" = "Buscando su dirección…";
"Forget" = "Olvidar";
"Looking for PCs didn't work. Scan the QR code or type the address instead." = "No se pudieron buscar PC. Escanea el código QR o escribe la dirección.";
"Looking for SpoolUp on your PC…" = "Buscando SpoolUp en tu PC…";
"Name (optional)" = "Nombre (opcional)";
"Needs the free SpoolUp app for Windows on your PC. The demo works without it." = "Necesita la app gratuita SpoolUp para Windows en tu PC. La demo funciona sin ella.";
"On this network" = "En esta red";
"Open Settings" = "Abrir Ajustes";
"Point the camera at the QR code in the SpoolUp window on your PC." = "Apunta la cámara al código QR de la ventana de SpoolUp en tu PC.";
"Privacy" = "Privacidad";
"Saved PCs" = "PC guardados";
"Scan again" = "Escanear de nuevo";
"Scan the QR code" = "Escanear el código QR";
"Scan the QR code on your PC" = "Escanear el código QR de tu PC";
"SpoolUp can't look for PCs: Local Network is off for it." = "SpoolUp no puede buscar PC: tiene desactivada la red local.";
"SpoolUp collects nothing. The PCs you save stay on this device. The deck talks only to your PC, and loads its fonts from Google Fonts." = "SpoolUp no recopila nada. Los PC que guardas se quedan en este dispositivo. El panel solo habla con tu PC y carga sus fuentes de Google Fonts.";
"SpoolUp is an unofficial fan project. It isn't made by, affiliated with or endorsed by the maker of any game." = "SpoolUp es un proyecto no oficial de fans. No lo ha creado, ni está vinculado ni respaldado por el creador de ningún juego.";
"SpoolUp needs the camera to scan the QR code. You can turn it on in Settings, or type the address instead." = "SpoolUp necesita la cámara para escanear el código QR. Puedes activarla en Ajustes o escribir la dirección.";
"SpoolUp only connects to PCs on your home network, like 192.168.1.20." = "SpoolUp solo se conecta a PC de tu red doméstica, como 192.168.1.20.";
"SpoolUp turns this iPad or iPhone into a control deck for your gaming PC. Each tap sends one key press to the SpoolUp app on the PC, over your home network." = "SpoolUp convierte este iPad o iPhone en un panel de control para tu PC de juegos. Cada toque envía una pulsación de tecla a la app SpoolUp del PC por tu red doméstica.";
"Start SpoolUp on your gaming PC. It shows up here when the iPad or iPhone is on the same Wi-Fi." = "Inicia SpoolUp en tu PC de juegos. Aparecerá aquí cuando el iPad o iPhone esté en la misma Wi-Fi.";
"That QR code isn't a SpoolUp address. Use the one in the SpoolUp window on your PC." = "Ese código QR no es una dirección de SpoolUp. Usa el de la ventana de SpoolUp en tu PC.";
"That isn't a SpoolUp address. It starts with http://" = "Esa no es una dirección de SpoolUp. Empieza por http://";
"The PC didn't answer. Is SpoolUp running on it, on the same network?" = "El PC no respondió. ¿Está SpoolUp abierto en él, en la misma red?";
"The SpoolUp window on your PC shows its address. The deck asks for the pairing code next." = "La ventana de SpoolUp en tu PC muestra su dirección. Después, el panel te pedirá el código de emparejamiento.";
"The demo runs without a PC. Presses only light up the buttons." = "La demo funciona sin PC. Las pulsaciones solo iluminan los botones.";
"The port must be a number from 1024 to 65535." = "El puerto debe ser un número de 1024 a 65535.";
"Try the demo" = "Probar la demo";
"Type the address" = "Escribir la dirección";
"Type the address the SpoolUp window shows on your PC." = "Escribe la dirección que muestra la ventana de SpoolUp en tu PC.";
"Use the PC's IPv4 address, like 192.168.1.20." = "Usa la dirección IPv4 del PC, como 192.168.1.20.";
